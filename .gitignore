# Claude Code agents' scratch checkouts
/.claude/worktrees/

# MakeHuman asset packs: the parts our people use are kept unzipped in source/mh/assets/;
# the packs themselves (some over GitHub's 100 MB limit) come back with tools/people/fetch/mh.sh
/web/people/source/mh/*.zip

# The car models as their authors published them (big): tools/cars/fetch.py gets them back
/web/cars/source/sketchfab/*/model.glb
# The library's other vehicles as their authors published them: tools/cars/vehicles.py fetch gets them back
/web/cars/source/vehicles/*/model.glb
