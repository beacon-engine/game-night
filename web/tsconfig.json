{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@platform": [
        "./platform/index.ts"
      ],
      "@racing/*": [
        "./racing/*"
      ],
      "@world/*": [
        "./world/*"
      ],
      "@people/*": [
        "./people/*"
      ],
      "@armoury/*": [
        "./armoury/*"
      ]
    }
  },
  "include": [
    "platform",
    "world",
    "racing",
    "people",
    "armoury",
    "hub",
    "pad",
    "games"
  ]
}
